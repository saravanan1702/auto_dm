# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Free Postgres from https://neon.tech (or Vercel → Storage → Neon). Use the pooled connection string.
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Your dashboard login password (pick a long one).
ADMIN_PASSWORD=change-me-to-something-long

# Random string, 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# From developers.facebook.com → your app → Instagram → API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=

# Any random string; paste the same value in the Meta webhook settings.
IG_WEBHOOK_VERIFY_TOKEN=

# Your deployed URL, no trailing slash (e.g. https://my-autodm.vercel.app)
APP_URL=http://localhost:3000

# Random string; Vercel sends it to /api/cron automatically when this env var exists.
CRON_SECRET=

# Optional
# APP_TIMEZONE=Asia/Kolkata
# IG_GRAPH_VERSION=v23.0
